{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "texas-sandfest-public-api",
  "main": "./index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sandfest-api.heyelab.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "texas-sandfest-public-api-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": []
    }
  }
}
